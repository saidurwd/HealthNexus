includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - modules
    # Level 5 for the code written so far; new code should be clean (the baseline lists today's findings only).
    # Raise toward the guideline's level 6 as the baseline shrinks.
    level: 5
    ignoreErrors: []
